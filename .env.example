# Copy this file to .env and replace the placeholders.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=phishguard_db
DB_USER=phishguard_app
DB_PASSWORD=replace_with_a_strong_password

# Generate hashes with:
# python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('replace-me'))"
SECRET_KEY=replace_with_a_long_random_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace_with_generated_password_hash
COOKIE_SECURE=false
TRUST_PROXY=false
# Use redis://host:6379/0 in multi-worker production deployments.
RATELIMIT_STORAGE_URI=memory://

# Optional reputation providers. Keep real keys only in .env / hosting secrets.
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

